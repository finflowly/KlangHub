<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KlangHub</RootNamespace>
    <AssemblyName>KlangHub</AssemblyName>
    <Product>KlangHub</Product>
    <Version>0.0.1</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>KlangHub.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Label="MultilingualAppToolkit">
    <MultilingualAppToolkitVersion>4.0</MultilingualAppToolkitVersion>
    <MultilingualFallbackLanguage>en</MultilingualFallbackLanguage>
    <TranslationReport Condition="'$(Configuration)' == 'Release'">true</TranslationReport>
    <SuppressPseudoWarning Condition="'$(Configuration)' == 'Debug'">true</SuppressPseudoWarning>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="KlangHub.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="UserControls\Pause.png" />
    <EmbeddedResource Include="UserControls\Play.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Branded full-screen now-playing artwork served to the Chromecast (LOAD metadata image url). -->
    <EmbeddedResource Include="Resources\artwork.png">
      <LogicalName>KlangHub.Resources.artwork.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="UserControls\Unmute.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="UserControls\Mute.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="UserControls\Stop.png" />
  </ItemGroup>
  <ItemGroup>
    <XliffResource Include="MultilingualResources\KlangHub.fr.xlf" />
  </ItemGroup>
  <Target Name="MATPrerequisite" BeforeTargets="PrepareForBuild" Condition="!Exists('$(MSBuildExtensionsPath)\Microsoft\Multilingual App Toolkit\Microsoft.Multilingual.ResxResources.targets')" Label="MultilingualAppToolkit">
    <Warning Text="$(MSBuildProjectFile) is Multilingual build enabled, but the Multilingual App Toolkit is unavailable during the build. If building with Visual Studio, please check to ensure that toolkit is properly installed." />
  </Target>
  <ItemGroup>
    <!-- net10 bump: Microsoft.CSharp (no `dynamic` usage), Microsoft.VisualBasic (WindowsFormsApplicationBase
         ships in-box via Microsoft.VisualBasic.Forms under net10.0-windows WinForms), and the legacy
         System.Memory / System.Numerics.Vectors / System.Runtime.CompilerServices.Unsafe /
         System.Threading.Tasks.Extensions polyfills are all part of the shared framework now — dropped. -->
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <!-- net10: System.Text.Json is provided in-box by the shared framework (SDK NU1510) — no package ref needed. -->
    <PackageReference Include="Tmds.MDns" Version="0.8.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KlangHub.Core\KlangHub.Core.csproj" />
    <ProjectReference Include="..\KlangHub.Platform\KlangHub.Platform.csproj" />
  </ItemGroup>
</Project>