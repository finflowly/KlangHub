<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows SDK version required for Windows.Media.Control (SMTC): the now-playing session
         Windows itself keeps, which is how KlangHub learns what an external player is playing. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>KlangHub</RootNamespace>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2.2b-H4c: let the test project reach internal Chromecast helpers (ChromecastStateMapper, ChromecastDeviceId). -->
    <InternalsVisibleTo Include="KlangHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Cast wire format, compiled from its own definition at build time. It used to be a checked-in
         72 KB generated file plus a Google.ProtocolBuffers.dll from 2013 - unmaintained for over a decade,
         and impossible to update. Now the .proto IS the source, and protoc runs as part of the build. -->
    <Protobuf Include="ProtocolBuffer/CastChannel.proto" GrpcServices="None" />
    <!-- Clementine's network remote. Apache-2.0, reduced and re-stated in proto3 - see the file's own
         header for why, and docs/THIRD-PARTY-LICENSES.md for the attribution. -->
    <Protobuf Include="ProtocolBuffer/ClementineRemote.proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <!-- Managed FLAC (FLAKE) encoder for lossless live streaming. LGPL-3.0: shipped as a separate,
         replaceable DLL (framework-dependent build) + attribution in docs/THIRD-PARTY-LICENSES.md. -->
    <PackageReference Include="CUETools.Codecs.FLAKE" Version="1.0.5" />
    <PackageReference Include="Tmds.MDns" Version="0.9.1" />
    <!-- net10: System.Text.Json is provided in-box by the shared framework (SDK NU1510) — no package ref needed. -->
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.11" />
    <PackageReference Include="z440.atl.core" Version="7.16.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KlangHub.Core\KlangHub.Core.csproj" />
  </ItemGroup>
</Project>
